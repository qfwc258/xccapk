<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center_horizontal"
    android:background="#0e1116">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:textSize="16sp"
        android:hint="@string/hint_sub"
        android:textColor="#ffffff"
        android:textColorHint="#7a8694"
        android:inputType="textUri|textMultiLine"
        android:background="#1c2330"
        android:padding="12dp" />

    <EditText
        android:id="@+id/etSecret"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginTop="12dp"
        android:textSize="16sp"
        android:hint="@string/hint_secret"
        android:textColor="#ffffff"
        android:textColorHint="#7a8694"
        android:inputType="textVisiblePassword"
        android:background="#1c2330"
        android:padding="12dp" />

    <CheckBox
        android:id="@+id/cbLan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cb_lan"
        android:textSize="18sp"
        android:textColor="#ffffff"
        android:layout_marginTop="16dp"
        android:focusable="true" />

    <CheckBox
        android:id="@+id/cbBoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cb_boot"
        android:textSize="18sp"
        android:textColor="#ffffff"
        android:layout_marginTop="8dp"
        android:focusable="true" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="160dp"
            android:minHeight="56dp"
            android:text="@string/btn_start"
            android:textSize="18sp"
            android:focusable="true"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="160dp"
            android:minHeight="56dp"
            android:text="@string/btn_stop"
            android:textSize="18sp"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:textSize="14sp"
        android:textColor="#9fe6a0"
        android:typeface="monospace"
        android:scrollbars="vertical" />
</LinearLayout>

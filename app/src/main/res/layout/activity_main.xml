<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="16dp">

    <!-- 顶部标题卡 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/bg_title_card">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📺 TV端  XCCTV助手"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="源地址解析 · 4线程并行下载 · 本地缓存"
            android:textColor="#94A3B8"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- ✅ 下载状态横幅（初始隐藏） -->
    <TextView
        android:id="@+id/tv_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_banner_loading"
        android:visibility="gone"/>

    <!-- URL 输入 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/bg_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔗 源地址"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/et_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="粘贴 vod.json / jsm.json / XYQ.json 直链..."
            android:inputType="textUri"
            android:singleLine="true"
            android:textSize="13sp"
            android:textColor="#E2E8F0"
            android:textColorHint="#64748B"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:textCursorDrawable="@null"/>
    </LinearLayout>

    <!-- 按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚀 开始下载"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary"
            android:paddingVertical="12dp"
            android:paddingHorizontal="4dp"
            android:elevation="2dp"/>

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🗑️ 清空"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:background="@drawable/bg_btn_ghost"
            android:paddingVertical="12dp"
            android:paddingHorizontal="4dp"
            android:layout_marginStart="8dp"
            android:elevation="1dp"/>

        <Button
            android:id="@+id/btn_folder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎯 默认源"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:background="@drawable/bg_btn_ghost"
            android:paddingVertical="12dp"
            android:paddingHorizontal="4dp"
            android:layout_marginStart="8dp"
            android:elevation="1dp"/>
    </LinearLayout>

    <!-- ✅ 权限状态条 + 授权按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_perm_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="检查权限中..."
            android:textSize="12sp"
            android:textColor="#94A3B8"
            android:paddingVertical="6dp"/>

        <Button
            android:id="@+id/btn_perm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔐 授权"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/bg_btn_primary"
            android:paddingVertical="6dp"
            android:paddingHorizontal="16dp"
            android:elevation="1dp"/>
    </LinearLayout>

    <!-- 进度条 -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:progressTint="#22D3EE"
        android:progressBackgroundTint="#1E293B"
        android:indeterminate="false"
        android:max="100"
        android:visibility="gone"/>

    <!-- 状态输出 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:textSize="12.5sp"
        android:textColor="#CBD5E1"
        android:padding="14dp"
        android:background="@drawable/bg_log"
        android:fontFamily="monospace"
        android:scrollbars="vertical"
        android:textIsSelectable="true"/>
</LinearLayout>

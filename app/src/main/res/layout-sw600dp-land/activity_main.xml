<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_page"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_title_card">
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_tv"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_banner_loading"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_source"
                android:textColor="@color/text_body"
                android:textSize="13sp"
                android:layout_marginBottom="8dp"/>
            <Spinner
                android:id="@+id/sp_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_tv"
                android:padding="12dp"
                android:spinnerMode="dropdown"
                android:nextFocusDown="@id/btn_start"/>
            <EditText
                android:id="@+id/et_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/hint_custom_url"
                android:inputType="textUri"
                android:singleLine="true"
                android:textSize="14sp"
                android:textColor="@color/text_input"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/bg_input_tv"
                android:padding="14dp"
                android:textCursorDrawable="@null"
                android:visibility="gone"
                android:nextFocusDown="@id/btn_start"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_start"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary_tv"
            android:paddingVertical="16dp"
            android:nextFocusUp="@id/sp_source"
            android:nextFocusDown="@id/btn_stop"/>

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/btn_stop"
            android:textColor="@color/text_input"
            android:textSize="15sp"
            android:background="@drawable/bg_btn_ghost_tv"
            android:paddingVertical="14dp"
            android:enabled="false"
            android:nextFocusUp="@id/btn_start"
            android:nextFocusDown="@id/btn_perm"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tv_perm_status"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/perm_checking"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"/>
            <Button
                android:id="@+id/btn_perm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_grant_permission"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:background="@drawable/bg_btn_primary_tv"
                android:paddingVertical="10dp"
                android:paddingHorizontal="20dp"
                android:nextFocusUp="@id/btn_stop"
                android:nextFocusDown="@id/cb_boot"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_save_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"/>

        <CheckBox
            android:id="@+id/cb_boot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/boot_launch"
            android:textColor="@color/text_body"
            android:textSize="14sp"
            android:buttonTint="@color/cyan"
            android:checked="false"
            android:nextFocusUp="@id/btn_perm"
            android:nextFocusDown="@id/tv_status"/>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:progressTint="@color/cyan"
            android:progressBackgroundTint="@color/progress_bg"
            android:indeterminate="false"
            android:max="100"
            android:visibility="gone"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="16dp"
        android:textSize="13sp"
        android:textColor="@color/text_body"
        android:background="@drawable/bg_log"
        android:fontFamily="monospace"
        android:scrollbars="vertical"
        android:textIsSelectable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@id/btn_perm"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_page"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="@drawable/bg_title_card">

            <View
                android:layout_width="3dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_accent_bar"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/title_tv"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02"/>

                    <TextView
                        android:id="@+id/tv_device"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_tv"
                        android:textColor="@color/cyan"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:background="@drawable/bg_chip"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="start"
            android:text="@string/banner_idle"
            android:background="@drawable/bg_banner_idle"
            android:maxLines="2"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_source"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp"/>

            <Spinner
                android:id="@+id/sp_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_tv"
                android:padding="6dp"
                android:spinnerMode="dropdown"
                android:popupBackground="@drawable/bg_spinner_popup"
                android:nextFocusDown="@id/btn_start"/>

            <LinearLayout
                android:id="@+id/custom_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_url"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/hint_custom_url"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:textColor="@color/text_input"
                    android:textColorHint="@color/text_hint"
                    android:background="@drawable/bg_input_tv"
                    android:padding="14dp"
                    android:textCursorDrawable="@null"
                    android:nextFocusDown="@id/btn_start"/>

                <Button
                    android:id="@+id/btn_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_clear"
                    android:textColor="@color/btn_ghost_text"
                    android:textSize="14sp"
                    android:background="@drawable/bg_btn_ghost_tv"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:contentDescription="@string/cd_clear"/>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="@string/btn_start"
            android:textColor="@color/btn_primary_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary_tv"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:nextFocusUp="@id/sp_source"
            android:nextFocusDown="@id/btn_stop"/>

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="@string/btn_stop"
            android:textColor="@color/btn_ghost_text"
            android:textSize="15sp"
            android:background="@drawable/bg_btn_ghost_tv"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:enabled="false"
            android:nextFocusUp="@id/btn_start"
            android:nextFocusDown="@id/btn_perm"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_storage"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_perm_status"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_checking"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:paddingEnd="8dp"/>

                <Button
                    android:id="@+id/btn_perm"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:text="@string/btn_grant_permission"
                    android:textColor="@color/btn_ghost_text"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_ghost_tv"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:nextFocusUp="@id/btn_stop"
                    android:nextFocusDown="@id/cb_boot"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_save_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                android:fontFamily="monospace"
                android:maxLines="2"
                android:ellipsize="middle"/>

            <CheckBox
                android:id="@+id/cb_boot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/boot_launch"
                android:textColor="@color/text_body"
                android:textSize="14sp"
                android:buttonTint="@color/cyan"
                android:checked="false"
                android:nextFocusUp="@id/btn_perm"
                android:nextFocusDown="@id/tv_status"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="14dp"
            android:progressDrawable="@drawable/bg_progress"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_log"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_log_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_log"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="@color/text_body"
            android:lineSpacingExtra="4dp"
            android:fontFamily="monospace"
            android:scrollbars="vertical"
            android:textIsSelectable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_perm"/>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 主按钮 focus/unfocus selector -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#06B6D4" android:endColor="#A855F7" android:angle="135"/>
            <corners android:radius="14dp"/>
            <stroke android:width="3dp" android:color="#22D3EE"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#475569"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#22D3EE" android:endColor="#7C3AED" android:angle="135"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>
